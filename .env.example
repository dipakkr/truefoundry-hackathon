# ---- "prod" database (Neon, or any Postgres 16) ----
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- pgwarden MCP server ----
PGWARDEN_PORT=8787
PGWARDEN_TOKEN=change-me-to-a-random-32-char-string
PGWARDEN_MASK_KEY=change-me-to-another-random-string

# ---- TrueForge ----
TRUEFORGE_BASE_URL=http://localhost:8790

# ---- Model: TrueFoundry AI Gateway (preferred) ----
TFY_GATEWAY_BASE_URL=
TFY_GATEWAY_API_KEY=
MODEL_ID=
# ---- ...or a plain OpenAI or Anthropic key if the gateway vars are empty ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Sandbox: Daytona key with write:sandboxes, write:snapshots, delete:snapshots ----
DAYTONA_API_KEY=

# ---- GitHub: token for the TrueForge GitHub connector (defaults to `gh auth token`) ----
GITHUB_TOKEN=

# ---- First demo project (shopkart, bundled seed): target repo for npm run demo-pr / e2e ----
SHOPKART_REPO=your-github-user/shopkart
PR_NUMBER=1

# ---- Skill source (this repo, public). Pin SKILL_REF to a commit SHA for anything you demo or rely on ----
SKILL_REPO_URL=https://github.com/your-github-user/truefoundry-hackathon
SKILL_REF=main

# ---- Onboarded projects: one prod database URL per project, named in projects/<name>.json ("database_url_env") ----
# npm run onboard -- --project ledgerly --repo <you>/ledgerly --db-env LEDGERLY_DATABASE_URL
LEDGERLY_DATABASE_URL=postgres://postgres:dev@localhost:55432/ledgerly
